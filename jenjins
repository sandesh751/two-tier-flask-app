@Library("my-lib") _
pipeline{
    agent{label "vinod"}
    
    stages{
        stage("code"){
            steps{
                script{
                    clone3("https://github.com/sandesh751/two-tier-flask-app.git","main")
                }
            }
        }
        stage("build"){
            steps{
                script{
                    build3("docker-app", "latest")
                }
            }
        }
        stage("push"){
            steps{
                script{
                    push3("${env.dockerHubUser}","docker-app","latest")
                }
            }
        }
        stage("deploy"){
            steps{
                script{
                    deploy()
                }
            }
        }
    }
}
